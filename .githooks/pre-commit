#!/bin/bash
# Pre-commit enforcement hook for claude-code-reviewer
# Source: https://github.com/jazzsequence/claude-code-reviewer
#
# Reads configuration from .reviewer-config.sh in the project root.
# Copy to .git/hooks/pre-commit and chmod +x, or use install.sh.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# ── Load config ──────────────────────────────────────────────────────────────
# Defaults — override in .reviewer-config.sh
REVIEWER_TEST_CMD="npm test -- --run"
REVIEWER_LINT_CMD="npm run lint"
REVIEWER_BUILD_CMD="npm run build"
REVIEWER_E2E_CMD=""                        # empty = skip E2E
REVIEWER_MAX_FILES=5                       # max changed files (add/modify/delete; AI commits)
REVIEWER_MAX_RENAMES=20                    # max renamed files (AI commits)
REVIEWER_MAX_INSERTIONS=500                # max inserted lines (AI commits)
REVIEWER_APPROVAL_TIMEOUT=300             # seconds before approval expires
REVIEWER_APPROVAL_FILE="reviewer-approved" # relative to project root
REVIEWER_TEXT_ONLY_PATTERN='\.(md|txt)$'  # file types that skip test suite
REVIEWER_EXCLUDED_FILES='^package-lock\.json$|^yarn\.lock$|^pnpm-lock\.yaml$'

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
CONFIG_FILE="$REPO_ROOT/.reviewer-config.sh"

if [ -f "$CONFIG_FILE" ]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

APPROVAL_FILE="$REPO_ROOT/$REVIEWER_APPROVAL_FILE"

# ── Header ───────────────────────────────────────────────────────────────────
echo "🔍 Pre-Commit Validation"
echo "=============================="
echo ""

# ── Step 1: Reviewer approval ────────────────────────────────────────────────
echo "1️⃣  Checking reviewer agent approval..."

if [ "$USER_COMMIT" = "1" ]; then
  echo -e "${YELLOW}⚠️  User commit bypass enabled${NC}"
  echo "   Skipping reviewer agent check (USER_COMMIT=1)"
else
  # Validation lives in lib/approval.sh so this hook and the PreToolUse handler run
  # the SAME code. The handler is gitignored and cannot be shipped or reviewed; while
  # each layer carried its own copy they drifted repeatedly, and every drift was a case
  # where one accepted a flag the other rejected.
  APPROVAL_LIB="$REPO_ROOT/.githooks/lib/approval.sh"

  if [ ! -f "$APPROVAL_LIB" ]; then
    echo -e "${RED}❌ BLOCKED: .githooks/lib/approval.sh is missing${NC}"
    echo "   Run ./.githooks/install.sh to repair the hook installation."
    exit 1
  fi

  # shellcheck source=lib/approval.sh
  source "$APPROVAL_LIB"

  reviewer_validate_approval "$APPROVAL_FILE" "$REVIEWER_APPROVAL_TIMEOUT" || exit 1
fi
echo ""

# ── Step 2: Commit size (AI commits only) ────────────────────────────────────
if [ "$USER_COMMIT" != "1" ]; then
  echo "2️⃣  Checking commit size..."

  # Renames are lower-risk than edits — track them separately
  STAGED_RENAMES=$(git diff --cached --diff-filter=R --name-only \
    | grep -Ev "$REVIEWER_EXCLUDED_FILES" \
    | wc -l | tr -d ' ')

  STAGED_EDITS=$(git diff --cached --diff-filter=r --name-only \
    | grep -Ev "$REVIEWER_EXCLUDED_FILES" \
    | wc -l | tr -d ' ')

  # numstat + awk, NOT a pathspec include-list. Building pathspecs from the
  # non-excluded files breaks when EVERY staged file is excluded: the list comes out
  # empty, `git diff --cached --stat --` falls back to all files, and the lockfile's
  # insertions get counted. That hard-blocks lockfile-only commits — every Dependabot
  # merge — with no legitimate route past it, since agents must not use USER_COMMIT=1.
  # numstat filters per row, so an all-excluded stage yields 0. `-` is git's marker
  # for a binary file and must not be summed as a number.
  # --no-renames: numstat renders a rename as `dir/{old => new}.json`, which will not
  # match an anchored pattern like ^package-lock\.json$, so a RENAMED lockfile would
  # slip past the exclusion. With --no-renames it appears as a delete plus an add, both
  # with plain paths, and the exclusion matches.
  STAGED_INSERTIONS=$(git diff --cached --numstat --no-renames \
    | awk -F'\t' -v ex="$REVIEWER_EXCLUDED_FILES" \
        '$3 !~ ex { s += ($1 == "-" ? 0 : $1) } END { print s+0 }')

  if [ "$STAGED_EDITS" -gt "$REVIEWER_MAX_FILES" ]; then
    echo -e "${RED}❌ BLOCKED: Commit too large — $STAGED_EDITS files changed (max $REVIEWER_MAX_FILES for AI commits)${NC}"
    echo "   Split into smaller, atomic commits:"
    git diff --cached --diff-filter=r --name-only | grep -Ev "$REVIEWER_EXCLUDED_FILES" | sed 's/^/     /'
    exit 1
  fi

  if [ "$STAGED_RENAMES" -gt "$REVIEWER_MAX_RENAMES" ]; then
    echo -e "${RED}❌ BLOCKED: Too many renames — $STAGED_RENAMES files renamed (max $REVIEWER_MAX_RENAMES for AI commits)${NC}"
    echo "   Split into smaller, atomic commits:"
    git diff --cached --diff-filter=R --name-only | sed 's/^/     /'
    exit 1
  fi

  if [ "$STAGED_INSERTIONS" -gt "$REVIEWER_MAX_INSERTIONS" ]; then
    echo -e "${RED}❌ BLOCKED: Commit too large — ~$STAGED_INSERTIONS lines added (max $REVIEWER_MAX_INSERTIONS for AI commits)${NC}"
    echo "   Split into smaller, atomic commits."
    exit 1
  fi

  echo -e "${GREEN}✅ Commit size OK ($STAGED_EDITS changed, $STAGED_RENAMES renamed, ~$STAGED_INSERTIONS insertions)${NC}"
  echo ""
fi

# ── Step 3: Tests (skip for text-only changes) ───────────────────────────────
NON_TEXT_FILES=$(git diff --cached --name-only \
  | grep -Ev "$REVIEWER_EXCLUDED_FILES" \
  | grep -Ev "$REVIEWER_TEXT_ONLY_PATTERN" \
  | wc -l | tr -d ' ')

echo "3️⃣  Running tests..."
echo ""

if [ "$NON_TEXT_FILES" -eq 0 ]; then
  echo "   ℹ️  Text/markdown-only changes — skipping test suite"
  echo -e "${GREEN}✅ Tests skipped (no source code changed)${NC}"
  echo ""
else
  # Unit tests
  if [ -n "$REVIEWER_TEST_CMD" ]; then
    echo "   Running unit tests..."
    eval "$REVIEWER_TEST_CMD" 2>&1 | tail -6
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      echo -e "${RED}❌ BLOCKED: Unit tests failed${NC}"
      exit 1
    fi
    echo -e "${GREEN}✅ Unit tests passed${NC}"
  fi

  # Linter
  if [ -n "$REVIEWER_LINT_CMD" ]; then
    echo "   Running linter..."
    eval "$REVIEWER_LINT_CMD" 2>&1 | tail -3
    if [ "${PIPESTATUS[0]}" -ne 0 ]; then
      echo -e "${RED}❌ BLOCKED: Linter failed${NC}"
      exit 1
    fi
    echo -e "${GREEN}✅ Linter passed${NC}"
  fi

  # Build
  if [ -n "$REVIEWER_BUILD_CMD" ]; then
    echo "   Running build..."
    if ! eval "$REVIEWER_BUILD_CMD" > /tmp/reviewer-build-log.txt 2>&1; then
      echo -e "${RED}❌ BLOCKED: Build failed${NC}"
      tail -20 /tmp/reviewer-build-log.txt
      exit 1
    fi
    echo -e "${GREEN}✅ Build successful${NC}"
  fi

  # E2E tests (opt-in)
  if [ -n "$REVIEWER_E2E_CMD" ]; then
    echo "   Running E2E tests..."
    if ! eval "$REVIEWER_E2E_CMD"; then
      echo -e "${RED}❌ BLOCKED: E2E tests failed${NC}"
      exit 1
    fi
    echo -e "${GREEN}✅ E2E tests passed${NC}"
  fi

  echo ""
fi

# ── Step 4: Secrets check ────────────────────────────────────────────────────
echo "4️⃣  Checking for secrets..."
for file in $(git diff --cached --name-only); do
  if [[ "$file" == ".env" ]] || [[ "$file" == *".env."* ]] || \
     [[ "$file" == *"credentials"* ]] || [[ "$file" == *"secrets"* ]] || \
     [[ "$file" == "auth.json" ]]; then
    echo -e "${RED}❌ BLOCKED: Attempting to commit sensitive file: $file${NC}"
    exit 1
  fi
done
echo -e "${GREEN}✅ No secrets${NC}"
echo ""

# ── Step 5: Reviewer reminder (AI commits only) ──────────────────────────────
if [ "$USER_COMMIT" != "1" ]; then
  echo "5️⃣  Reviewer oversight check..."
  echo -e "${YELLOW}⚠️  MANDATORY: Reviewer agent must approve before every commit.${NC}"
  echo "   1. Spawn reviewer agent with Claude Code's Agent tool"
  echo "   2. Get APPROVE decision"
  echo "   3. Reviewer writes the approval flag (timestamp + index fingerprint)"
  echo "   4. Commit within ${REVIEWER_APPROVAL_TIMEOUT}s, without restaging"
  echo ""
fi

echo "=============================="
echo -e "${GREEN}✅ COMMIT ALLOWED${NC}"
echo ""
exit 0
